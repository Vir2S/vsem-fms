# Authentication: configure either the legacy API_KEY or the hashed API_KEYS registry.
# Legacy API_KEY is backward compatible and has admin access to all files.
API_KEY=
# New deployments should prefer API_KEYS. Generate a credential with:
# python -m vsem_fms.commands.hash_api_key --generate
# Example (keep the client secret outside this file; store only its SHA-256 here):
# API_KEYS='[{"id":"client-a","name":"Client A","secret_hash":"<64-char-sha256>","enabled":true,"scopes":["files:read","files:list"],"folder_prefix":"client-a/*"}]'
API_KEYS=[]

STORAGE_PATH=./storage
MAX_FILE_SIZE_MB=100
MIN_FREE_DISK_SPACE_MB=1024
# Backward-compatible legacy name: MAX_FILE_SIZE
MAX_FILE_AGE_HOURS=168
CLEANUP_INTERVAL_SECONDS=3600

LOG_LEVEL=INFO
LOG_FORMAT=json
LOG_DIR=./logs

SERVER_HOST=0.0.0.0
SERVER_PORT=5000
